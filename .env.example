# Published CSV link of your sheet (File > Share > Publish to web > pick the sheet > CSV)
SHEET_CSV_URL=
# TMDb v3 API key (https://www.themoviedb.org/settings/api) – or a v4 "read access token"
TMDB_API_KEY=
# Optional: set to 0 to skip the Letterboxd rating lookup (falls back to TMDb ratings)
LETTERBOXD=1
